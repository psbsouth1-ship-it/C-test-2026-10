{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试当前文件 (g++ / gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "D:/Program Files/mingw64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "解决 Windows 下中文路径导致的断点不全问题",
          "text": "set breakpoint condition-evaluation host",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "编译当前文件（生成 exe）"
    }
  ]
}
